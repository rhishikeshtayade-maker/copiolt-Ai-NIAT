# NIAT CodePilot Environment Configuration
# Copy this file to .env and configure values for your environment.

# ==============================================================
# Controller Settings (Central Laptop)
# ==============================================================
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8000
CONTROLLER_SECRET_KEY=change-this-to-a-secure-shared-token

# ==============================================================
# Worker Settings (Worker Laptops)
# ==============================================================
# Set the controller URL pointing to the central laptop's local network IP
# Example: http://192.168.1.100:8000
CONTROLLER_URL=http://localhost:8000
WORKER_ID=worker-laptop-01
WORKER_NAME="Worker Alpha"
HEARTBEAT_INTERVAL_SECONDS=5.0
HEARTBEAT_TIMEOUT_SECONDS=15.0

# ==============================================================
# Security & Ethics Compliance Guards
# ==============================================================
# Explicit student consent MUST be active for screen capturing
REQUIRE_EXPLICIT_PERMISSION=true
# Prohibit unauthorized anti-bot bypassing or automated portal submission
ALLOW_AUTOMATED_PORTAL_SUBMISSION=false
# Require human/student verification before executing suggested code actions
REQUIRE_STUDENT_APPROVAL_FOR_ACTIONS=true

# ==============================================================
# Database Integration (Supabase - Optional for local testing)
# ==============================================================
SUPABASE_URL=
SUPABASE_KEY=

# ==============================================================
# AI Engine (Google Gemini & OpenAI Multimodal Pipeline)
# ==============================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=60.0
OPENAI_MAX_RETRIES=3
OPENAI_JPEG_QUALITY=75
